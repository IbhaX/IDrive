# IDrive configuration — copy to .env and adjust.

# SQLite database location (async driver required).
# DATABASE_URL=sqlite+aiosqlite:///data/idrive.db

# Secret mixed into password/session hashing. MUST be changed in production;
# the app refuses to start with the default when IDRIVE_ENV=production.
# SECRET_PEPPER=change-me-in-production

# Environment: development | production
# ENVIRONMENT=development

# Bearer session lifetime in days.
# SESSION_TTL_DAYS=30

# Grace period (seconds) added to the mock-exam server deadline.
# EXAM_GRACE_SECONDS=10

# Rate limits (slowapi format).
# RATE_LIMIT_DEFAULT=300/minute
# RATE_LIMIT_AUTH=20/minute

# Comma-separated CORS origins. Default "*" is fine for local dev only.
# CORS_ORIGINS=*

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Google sign-in (Google Identity Services). Create an OAuth client of type
# "Web application" in Google Cloud Console and add your origin to
# "Authorized JavaScript origins" (e.g. http://localhost:5000).
# Empty GOOGLE_CLIENT_ID disables the Google button and endpoint.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI driving instructor — OpenRouter (https://openrouter.ai/keys).
# Copy this file to .env in the project root (it is git-ignored).
# Empty key = grounded search-only mode. Signed-in users get AI answers.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini          # any model id from openrouter.ai/models
# OPENROUTER_SITE_URL=https://your-domain       # optional attribution header
# RATE_LIMIT_AI=12/minute

# Public site (canonical URLs, sitemaps, robots.txt, llms.txt, JSON-LD)
# SITE_URL=https://idrive.ibhax.com
# CONTACT_EMAIL=hello@example.com              # shown on About/Privacy/Terms
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...   # Install page + footer
# REDIRECT_WWW=true                            # www.<host> -> <host> (301)
# FORCE_HTTPS=false                            # prefer Cloudflare "Always Use HTTPS"

# Optional Google Analytics 4 / Google Ads (empty = no analytics at all)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# ADS_ID=AW-XXXXXXXXX
# ADS_SIGNUP_LABEL=xxxxxxxxxxxxxxxx            # conversion label for sign_up
