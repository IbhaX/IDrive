# IDrive configuration — copy to .env and adjust.

# SQLite database location (async driver required).
# DATABASE_URL=sqlite+aiosqlite:///data/idrive.db

# Secret mixed into password/session hashing. MUST be changed in production;
# the app refuses to start with the default when IDRIVE_ENV=production.
# SECRET_PEPPER=change-me-in-production

# Environment: development | production
# ENVIRONMENT=development

# Bearer session lifetime in days.
# SESSION_TTL_DAYS=30

# Grace period (seconds) added to the mock-exam server deadline.
# EXAM_GRACE_SECONDS=10

# Rate limits (slowapi format).
# RATE_LIMIT_DEFAULT=300/minute
# RATE_LIMIT_AUTH=20/minute

# Comma-separated CORS origins. Default "*" is fine for local dev only.
# CORS_ORIGINS=*

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Google sign-in (Google Identity Services). Create an OAuth client of type
# "Web application" in Google Cloud Console and add your origin to
# "Authorized JavaScript origins" (e.g. http://localhost:5000).
# Empty GOOGLE_CLIENT_ID disables the Google button and endpoint.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI driving instructor — any OpenAI-compatible chat-completions API
# (OpenRouter by default). Empty AI_API_KEY keeps the instructor in grounded
# search-only mode; signed-in users get AI answers when a key is set.
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini
# RATE_LIMIT_AI=12/minute
